{
  "manifest_version": 3,
  "name": "Smart Subtitles",
  "description": "YouTube videolarındaki mevcut altyazıları doğal Türkçeye çevirmek için hazırlanmış eklenti.",
  "version": "1.20.5",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Smart Subtitles",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "assets/pageBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "assets/youtubeContentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
